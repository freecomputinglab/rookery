# rheo is NOT in this repo's devShell — locally it is the sibling `rheo/` crate
# (`cargo install --path ../../../../rheo`, or point at a built binary). CI does
# NOT need that: it installs a pinned rheo RELEASE at or above this package's
# declared `[tool.rheo] min_version` of 0.6.2, and runs `just check` below.
# So this recipe is both the local check and the CI one, against the floor the
# manifest promises rather than whatever a developer happens to have built.
#
# To run it against a specific rheo instead of whatever is on PATH — which is
# how the floor is verified — invoke the binary directly:
#   /path/to/rheo compile . && ./check.sh
build:
    rheo compile .

watch:
    rheo watch . --html --open

# Asserts on the OUTPUT, not merely that the build succeeded — every path below
# exists only under rheo and none of it is covered by `demo/pure`.
#
# CLEANS FIRST, and that is required rather than tidy. `rheo compile` writes
# pages; it does not remove one that is no longer produced. Several assertions
# here are about ABSENCE — `ideas/private-note.html` must NOT exist, and certain
# strings must appear nowhere in the tree — so a page left behind by an earlier
# build fails them for the wrong reason. MEASURED: after one run with the
# exclusion deliberately disabled, the stale `ideas/private-note.html` made the
# very next (correct) run fail. `build/` is gitignored and holds nothing but
# output, so there is nothing to lose by removing it.
check: clean build
    ./check.sh

geom: build
    ./geom.sh

clean:
    rm -rf build

# The same rookery, compiled WITHOUT rheo — one document, no minted pages,
# every href an in-page fragment. `--features html` is mandatory for both
# formats, not only for HTML.
typst:
    mkdir -p build
    typst compile --features html --format html --root ../../../.. native.typ build/native.html
    typst compile --features html --root ../../../.. native.typ build/native.pdf

# Asserts on `build/native.html` — see check-native.sh's own header for why it
# is a separate script rather than a mode flag on `check.sh`.
check-typst: typst
    ./check-native.sh
